VITE_CHAT_API_URL=https://llm.arz.ai/v1/completions
VITE_CHAT_PORTFOLIO_AGENT_ID=agt-your-portfolio-assistant-agent-id
VITE_CHAT_MATRIX_RPG_AGENT_ID=agt-your-matrix-rpg-agent-id

# Optional and client-visible. Do not put real secrets in Vite env variables.
# Leave blank to omit the Authorization header.
VITE_CHAT_API_KEY=

# Project artwork: legacy (default) or generated. Build/restart after changing.
VITE_PROJECT_IMAGES=legacy
# Generated covers: 7-9 have no characters and distinct scenes per project (default: 7).
# Earlier sets 1-6 remain available by explicit selection.
VITE_PROJECT_IMAGE_VARIANT=7

# Legacy local names still resolve for backward compatibility during migration:
# VITE_COMPLETIONS_API_URL=
# VITE_CHATBOT_AGENT_MODEL=
# VITE_MATRIX_RPG_AGENT_MODEL=
